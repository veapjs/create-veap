{
  "name": "create-veap",
  "version": "0.4.0",
  "author": "Damian Miller",
  "type": "module",
  "description": "Initializer for Veap Framework applications",
  "bugs": "https://github.com/veapjs/create-veap/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/veapjs/create-veap.git"
  },
  "bin": {
    "create-veap": "./cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "start": "node ./dist/index.js",
    "dev": "bun build --watch",
    "compile": "rimraf dist && rm -rf templates && cp -r ../../templates templates && rm -rf templates/*/node_modules templates/*/.next templates/*/.cache templates/*/*.tsbuildinfo && (for d in templates/*; do mv $d/.gitignore $d/gitignore || true; done) && bun run build ",
    "build": "tsc",
    "test": "npm_config_user_agent=bun vitest run"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@types/fs-extra": "^11.0.4",
    "@types/tar": "^7.0.87",
    "execa": "^10.0.1",
    "fs-extra": "^11.4.1",
    "picocolors": "^1.1.1",
    "tar": "^7.5.22",
    "update-check": "^1.5.4",
    "vitest": "^5.0.3"
  }
}
