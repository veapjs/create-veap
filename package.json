{
  "name": "create-veap",
  "version": "0.1.0",
  "description": "Initializer for Veap Framework applications",
  "bugs": "https://github.com/veapjs/create-veap/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/veapjs/create-veap.git"
  },
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "bin": {
    "create-veap": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "stubs",
    ".docs"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
